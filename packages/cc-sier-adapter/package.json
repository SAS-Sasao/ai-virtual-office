{
  "name": "@ai-office/cc-sier-adapter",
  "private": true,
  "version": "0.0.0",
  "description": "CC-SIer の masters/*.md / .task-log/*.md をアプリ本体のスキーマ（OfficeLayout / Character / OfficeEvent）へ変換するアダプタ CLI",
  "type": "module",
  "bin": {
    "ai-office-adapter": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-office/protocol": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
